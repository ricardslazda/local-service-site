{
    "name": "local-service-site",
    "type": "module",
    "version": "0.0.1",
    "engines": {
        "node": ">=22.18.0"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "types:check": "astro check",
        "setup": "lefthook install",
        "test": "node --test",
        "audit": "node scripts/audit/index.ts",
        "gate": "npm run build && npm run audit",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@jdevalk/astro-seo-graph": "^2.2.0",
        "@jdevalk/seo-graph-core": "^0.7.0",
        "astro": "^7.3.2"
    },
    "allowScripts": {
        "esbuild": true
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@axe-core/playwright": "^4.13.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.62.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.4.1",
        "cheerio": "^1.2.0",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-astro": "^3.1.0",
        "globals": "^17.12.0",
        "lefthook": "^2.1.12",
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "^0.14.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "schema-dts": "^2.0.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.69.0"
    }
}
