---
interface Props {
    items: { href: string; label: string }[];
    class?: string;
}

const { items, class: className } = Astro.props;
---

<ul class:list={['flex flex-wrap gap-2', className]}>
    {
        items.map((item) => (
            <li>
                <a
                    href={item.href}
                    class="inline-flex min-h-10 items-center rounded-sm border border-ink px-4 text-sm font-semibold tracking-[0.04em] text-ink uppercase transition-colors duration-150 hover:bg-ink hover:text-band-ink"
                >
                    {item.label}
                </a>
            </li>
        ))
    }
</ul>
