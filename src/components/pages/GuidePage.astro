---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import QuoteBand from '../../components/QuoteBand.astro';
import Section from '../../components/Section.astro';
import { home } from '../../copy/home.ts';
import { hubs } from '../../copy/hubs.ts';
import { t } from '../../i18n/strings.ts';
import Layout from '../../layouts/Layout.astro';
import { alternatesOf, entriesIn } from '../../lib/content.ts';
import { formatDate, formatPrice, isoDate } from '../../lib/format.ts';
import {
    absoluteUrl,
    homePath,
    hubPath,
    guidePath,
    servicePath,
    slugOf,
} from '../../lib/paths.ts';
import type { Locale } from '../../site.ts';

interface Props {
    locale: Locale;
    entry: CollectionEntry<'guides'>;
}

const { locale, entry } = Astro.props;
const { data } = entry;
const strings = t(locale);
const path = guidePath(locale, slugOf(entry.id));
const url = absoluteUrl(path);
const { Content } = await render(entry);
const alternates = await alternatesOf('guides', entry, (code, sibling) =>
    guidePath(code, slugOf(sibling.id)),
);
const related = (await entriesIn('services', locale)).filter((service) =>
    data.services.includes(service.data.translationKey),
);
const breadcrumbs = [
    { name: strings.nav.home, url: absoluteUrl(homePath(locale)) },
    {
        name: hubs[locale].guides.heading,
        url: absoluteUrl(hubPath(locale, 'guides')),
    },
    { name: data.title, url },
];
---

<Layout
    locale={locale}
    title={data.title}
    description={data.description}
    path={path}
    alternates={alternates}
    breadcrumbs={breadcrumbs}
    datePublished={data.pubDate}
    dateModified={data.updatedDate}
    article={{
        url,
        headline: data.title,
        description: data.description,
        datePublished: data.pubDate,
        dateModified: data.updatedDate,
    }}
>
    <PageHero
        locale={locale}
        heading={data.title}
        lead={data.description}
        breadcrumbs={breadcrumbs}
    >
        <p
            slot="above"
            class="mb-5 font-display text-sm font-semibold tracking-[0.08em] text-accent uppercase"
        >
            <span class="sr-only">{strings.guides.published}:</span>
            <time datetime={isoDate(data.pubDate)}>
                {formatDate(data.pubDate, locale)}
            </time>
            {
                data.updatedDate && (
                    <>
                        {' · '}
                        <span>{strings.guides.updated}:</span>
                        <time datetime={isoDate(data.updatedDate)}>
                            {formatDate(data.updatedDate, locale)}
                        </time>
                    </>
                )
            }
        </p>
    </PageHero>

    <Section>
        <article class="max-w-prose">
            <Photo
                src={data.image}
                alt={data.imageAlt}
                widths={[480, 768, 1200]}
                sizes="(min-width: 48rem) 44rem, 100vw"
                class="aspect-video"
            />
            <div class="prose-body mt-10">
                <Content />
            </div>
        </article>

        {
            related.length > 0 && (
                <aside class="mt-16 max-w-prose border border-rule bg-paper p-6">
                    <h2 class="text-label font-semibold tracking-[0.14em] text-muted uppercase">
                        {strings.guides.relatedServices}
                    </h2>
                    <ul class="mt-3">
                        {related.map((service) => (
                            <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-t border-rule-2 py-3">
                                <a
                                    href={servicePath(
                                        locale,
                                        slugOf(service.id),
                                    )}
                                    class="font-display text-[20px] leading-none font-bold text-ink uppercase hover:text-accent"
                                >
                                    {service.data.name}
                                </a>
                                <span class="font-display text-base leading-none font-bold text-accent-deep">
                                    {service.data.priceFrom
                                        ? `${strings.services.from} ${formatPrice(service.data.priceFrom.amount, locale)}`
                                        : strings.services.onRequest}
                                </span>
                            </li>
                        ))}
                    </ul>
                </aside>
            )
        }
    </Section>

    <QuoteBand
        locale={locale}
        page={path}
        heading={home[locale].callBand.heading}
    />
</Layout>
