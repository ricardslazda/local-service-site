---
import JobCard from '../../components/JobCard.astro';
import PageHero from '../../components/PageHero.astro';
import QuoteBand from '../../components/QuoteBand.astro';
import Section from '../../components/Section.astro';
import { home } from '../../copy/home.ts';
import { hubs } from '../../copy/hubs.ts';
import { t } from '../../i18n/strings.ts';
import Layout from '../../layouts/Layout.astro';
import { jobsIn } from '../../lib/content.ts';
import { absoluteUrl, homePath, hubPath } from '../../lib/paths.ts';
import type { Locale } from '../../site.ts';
import { localeCodes } from '../../site.ts';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const copy = hubs[locale].jobs;
const jobs = await jobsIn(locale);
const path = hubPath(locale, 'jobs');
const alternates = Object.fromEntries(
    localeCodes.map((code) => [code, hubPath(code, 'jobs')]),
);
const breadcrumbs = [
    { name: t(locale).nav.home, url: absoluteUrl(homePath(locale)) },
    { name: copy.heading, url: absoluteUrl(path) },
];
---

<Layout
    locale={locale}
    title={copy.title}
    description={copy.description}
    path={path}
    alternates={alternates}
    pageType="CollectionPage"
    breadcrumbs={breadcrumbs}
>
    <PageHero
        locale={locale}
        heading={copy.heading}
        lead={copy.intro}
        breadcrumbs={breadcrumbs}
    />

    <Section>
        <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {jobs.map((entry) => <JobCard locale={locale} entry={entry} />)}
        </ul>
    </Section>

    <QuoteBand
        locale={locale}
        page={path}
        heading={home[locale].callBand.heading}
    />
</Layout>
