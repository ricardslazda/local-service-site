---
import { render } from 'astro:content';

import PageHero from '../../components/PageHero.astro';
import PriceTable from '../../components/PriceTable.astro';
import QuoteBand from '../../components/QuoteBand.astro';
import Section from '../../components/Section.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { home } from '../../copy/home.ts';
import { t } from '../../i18n/strings.ts';
import Layout from '../../layouts/Layout.astro';
import { alternatesOf, entriesIn, pageOf } from '../../lib/content.ts';
import {
    absoluteUrl,
    homePath,
    servicePath,
    slugOf,
    standalonePath,
} from '../../lib/paths.ts';
import type { Locale } from '../../site.ts';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const entry = await pageOf('prices', locale);
const { data } = entry;
const strings = t(locale);
const path = standalonePath(locale, 'prices');
const { Content } = await render(entry);
const alternates = await alternatesOf('pages', entry, (code, sibling) =>
    standalonePath(code, sibling.data.kind),
);
const services = await entriesIn('services', locale);
const breadcrumbs = [
    { name: strings.nav.home, url: absoluteUrl(homePath(locale)) },
    { name: strings.nav.prices, url: absoluteUrl(path) },
];
const term = 'text-label font-semibold tracking-[0.14em] text-muted uppercase';
---

<Layout
    locale={locale}
    title={data.title}
    description={data.description}
    path={path}
    alternates={alternates}
    breadcrumbs={breadcrumbs}
    datePublished={data.pubDate}
    dateModified={data.updatedDate}
>
    <PageHero
        locale={locale}
        heading={data.title}
        lead={data.summary}
        breadcrumbs={breadcrumbs}
    />

    <Section>
        <SectionHeader heading={strings.prices.perService} />
        <div class="mt-10 border-t border-rule">
            {
                services.map((service) => (
                    <section class="grid gap-6 border-b border-rule py-10 lg:grid-cols-[4fr_8fr] lg:gap-18">
                        <div>
                            <h3 class="font-display text-heading font-bold text-ink uppercase">
                                <a
                                    href={servicePath(
                                        locale,
                                        slugOf(service.id),
                                    )}
                                    class="hover:text-accent"
                                >
                                    {service.data.name}
                                </a>
                            </h3>
                            <p class="mt-3 text-[15px] text-ink-2">
                                {service.data.summary}
                            </p>
                        </div>
                        <PriceTable
                            locale={locale}
                            rows={service.data.prices.rows}
                            note={service.data.prices.note}
                        />
                    </section>
                ))
            }
        </div>
    </Section>

    <Section tone="paper" rule>
        <article class="prose-body">
            <Content />
        </article>
    </Section>

    {
        data.examples && (
            <Section>
                <SectionHeader heading={strings.prices.examples} />
                <ul class="mt-10 grid border-t border-l border-rule md:grid-cols-3">
                    {data.examples.map((example) => (
                        <li class="border-r border-b border-rule bg-paper p-7">
                            <h3 class="font-display text-heading-sm font-bold text-ink uppercase">
                                {example.title}
                            </h3>
                            <dl class="mt-5 grid gap-4 text-[15px] text-ink-2">
                                {example.facts.map((fact) => (
                                    <div>
                                        <dt class={term}>{fact.label}</dt>
                                        <dd class="mt-1">{fact.value}</dd>
                                    </div>
                                ))}
                                <div class="border-t border-rule-2 pt-4">
                                    <dt class={term}>{strings.prices.total}</dt>
                                    <dd class="mt-1.5 font-display text-[32px] leading-none font-extrabold text-ink">
                                        {example.total}
                                    </dd>
                                </div>
                            </dl>
                        </li>
                    ))}
                </ul>
            </Section>
        )
    }

    <QuoteBand
        locale={locale}
        page={path}
        heading={home[locale].callBand.heading}
    />
</Layout>
