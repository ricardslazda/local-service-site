---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Chips from '../../components/Chips.astro';
import Faq from '../../components/Faq.astro';
import JobCard from '../../components/JobCard.astro';
import PhoneAction from '../../components/PhoneAction.astro';
import Photo from '../../components/Photo.astro';
import PriceFrom from '../../components/PriceFrom.astro';
import PriceTable from '../../components/PriceTable.astro';
import QuoteBand from '../../components/QuoteBand.astro';
import Section from '../../components/Section.astro';
import Steps from '../../components/Steps.astro';
import { hubs } from '../../copy/hubs.ts';
import { t } from '../../i18n/strings.ts';
import Layout from '../../layouts/Layout.astro';
import { alternatesOf, entriesIn, jobsFor } from '../../lib/content.ts';
import { formatPrice } from '../../lib/format.ts';
import {
    absoluteUrl,
    anchorHref,
    homePath,
    hubPath,
    locationPath,
    servicePath,
    slugOf,
} from '../../lib/paths.ts';
import type { Locale } from '../../site.ts';

interface Props {
    locale: Locale;
    entry: CollectionEntry<'services'>;
}

const { locale, entry } = Astro.props;
const { data } = entry;
const strings = t(locale);
const path = servicePath(locale, slugOf(entry.id));
const url = absoluteUrl(path);
const { Content } = await render(entry);
const alternates = await alternatesOf('services', entry, (code, sibling) =>
    servicePath(code, slugOf(sibling.id)),
);
const siblings = (await entriesIn('services', locale)).filter(
    (candidate) => candidate.id !== entry.id,
);
const locations = await entriesIn('locations', locale);
const jobs = await jobsFor(locale, { service: data.translationKey });
const areaServed = [
    strings.base.name,
    ...locations.map((location) => location.data.name),
];
const served = [
    { href: homePath(locale), label: strings.base.name },
    ...locations.map((location) => ({
        href: locationPath(locale, slugOf(location.id)),
        label: location.data.name,
    })),
];
const breadcrumbs = [
    { name: strings.nav.home, url: absoluteUrl(homePath(locale)) },
    {
        name: hubs[locale].services.heading,
        url: absoluteUrl(hubPath(locale, 'services')),
    },
    { name: data.name, url },
];
const articleHeading =
    'font-display text-[28px] leading-none font-bold text-ink uppercase lg:text-[36px]';
const factTerm =
    'text-[13px] font-semibold tracking-[0.1em] text-band-muted uppercase';
---

<Layout
    locale={locale}
    quote={{ service: data.translationKey }}
    title={data.title}
    description={data.description}
    path={path}
    alternates={alternates}
    breadcrumbs={breadcrumbs}
    datePublished={data.pubDate}
    dateModified={data.updatedDate}
    service={{
        url,
        name: data.name,
        description: data.description,
        serviceType: data.name,
        areaServed,
        priceFrom: data.priceFrom,
    }}
>
    <Section tone="band" texture="stripes" class="pt-8 pb-24 lg:pt-8 lg:pb-28">
        <Breadcrumbs locale={locale} items={breadcrumbs} />
        <div
            class="mt-12 grid gap-10 lg:grid-cols-[8fr_4fr] lg:items-end lg:gap-18"
        >
            <div>
                <h1
                    class="max-w-[16ch] font-display text-[48px] leading-[0.95] font-extrabold uppercase lg:text-[clamp(48px,5.4vw,80px)]"
                >
                    {data.title}
                </h1>
                <p
                    class="mt-6 max-w-[58ch] text-[17px] leading-normal text-band-lead lg:text-[19px]"
                >
                    {data.summary}
                </p>
            </div>
            <dl class="grid">
                <div
                    class="flex flex-wrap items-baseline justify-between gap-4 border-b border-band-rule py-3.5"
                >
                    <dt class={factTerm}>{strings.services.priceFrom}</dt>
                    <dd>
                        {
                            data.priceFrom ? (
                                <PriceFrom
                                    locale={locale}
                                    amount={data.priceFrom.amount}
                                    unit={data.priceFrom.unit}
                                    size="lg"
                                    class="[&_span:first-child]:sr-only [&_span:last-child]:text-band-muted"
                                />
                            ) : (
                                <span class="font-display text-[40px] leading-none font-extrabold text-accent">
                                    {strings.services.onRequest}
                                </span>
                            )
                        }
                    </dd>
                </div>
                {
                    data.facts.map((fact) => (
                        <div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-band-rule py-3.5">
                            <dt class={factTerm}>{fact.label}</dt>
                            <dd class="font-display text-[22px] leading-none font-bold">
                                {fact.value}
                            </dd>
                        </div>
                    ))
                }
            </dl>
        </div>
    </Section>

    <div class="mx-auto -mt-16 max-w-page px-gutter lg:-mt-20">
        <Photo
            src={data.photo}
            alt={data.photoAlt}
            widths={[768, 1200, 1600]}
            sizes="(min-width: 80rem) 77.5rem, 100vw"
            class="aspect-[4/3] border-8 border-concrete md:aspect-[16/7]"
        />
    </div>

    <Section class="pt-14 lg:pt-18">
        <div class="grid gap-12 lg:grid-cols-[7fr_4fr] lg:gap-24">
            <article class="grid gap-12 text-[17px] text-ink-2">
                <p class="text-[19px] leading-normal">{data.intro}</p>

                <section>
                    <h2 class={articleHeading}>{data.covers.heading}</h2>
                    <ul
                        class="mt-6 grid border-t border-l border-rule sm:grid-cols-2"
                    >
                        {
                            data.covers.items.map((item) => (
                                <li class="border-r border-b border-rule bg-paper px-6 py-5">
                                    <h3 class="flex items-center gap-2.5 font-display text-[22px] leading-none font-bold text-ink uppercase">
                                        <span
                                            aria-hidden="true"
                                            class="size-2 shrink-0 bg-accent"
                                        />
                                        {item.title}
                                    </h3>
                                    <p class="mt-2.5 text-[15px]">
                                        {item.body}
                                    </p>
                                </li>
                            ))
                        }
                    </ul>
                </section>

                <div class="prose-body max-w-none">
                    <Content />
                </div>

                <section>
                    <h2 class={articleHeading}>{data.steps.heading}</h2>
                    <div class="mt-4">
                        <Steps items={data.steps.items} variant="rows" />
                    </div>
                </section>

                <section>
                    <h2 class={articleHeading}>{strings.services.prices}</h2>
                    <div class="mt-6">
                        <PriceTable
                            locale={locale}
                            rows={data.prices.rows}
                            note={data.prices.note}
                        />
                    </div>
                </section>

                {
                    jobs.length > 0 && (
                        <section>
                            <h2 class={articleHeading}>{strings.jobs.done}</h2>
                            <ul class="mt-6 grid gap-6 sm:grid-cols-2">
                                {jobs.map((job) => (
                                    <JobCard locale={locale} entry={job} />
                                ))}
                            </ul>
                        </section>
                    )
                }

                <section>
                    <h2 class={articleHeading}>{strings.services.whereWeDo}</h2>
                    <Chips items={served} class="mt-6" />
                </section>

                {
                    data.questions.length > 0 && (
                        <section>
                            <h2 class={articleHeading}>
                                {strings.services.questions}
                            </h2>
                            <div class="mt-6">
                                <Faq items={data.questions} size="md" />
                            </div>
                        </section>
                    )
                }
            </article>

            <aside
                class="grid content-start gap-4 self-start lg:sticky lg:top-26"
            >
                <div class="bg-band texture-grid p-8 text-band-ink">
                    <p
                        class="text-[13px] font-semibold tracking-[0.14em] text-band-muted uppercase"
                    >
                        {strings.services.asideLabel}
                    </p>
                    <p
                        class="mt-3 font-display text-[30px] leading-none font-bold uppercase"
                    >
                        {strings.services.asideHeading}
                    </p>
                    <div class="mt-6 grid gap-3">
                        <PhoneAction locale={locale} class="w-full" />
                        <a
                            href={anchorHref('quote')}
                            class="button button-outline-dark min-h-12 w-full"
                        >
                            {strings.cta.requestQuote}
                        </a>
                    </div>
                    <p class="mt-4 text-[13px] text-band-muted">
                        {strings.openingHours}
                    </p>
                </div>
                {
                    siblings.length > 0 && (
                        <div class="border border-rule bg-paper p-6">
                            <h2 class="text-label font-semibold tracking-[0.14em] text-muted uppercase">
                                {strings.services.others}
                            </h2>
                            <ul class="mt-3">
                                {siblings.map((sibling) => (
                                    <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-t border-rule-2 py-3">
                                        <a
                                            href={servicePath(
                                                locale,
                                                slugOf(sibling.id),
                                            )}
                                            class="font-display text-[20px] leading-none font-bold text-ink uppercase hover:text-accent"
                                        >
                                            {sibling.data.name}
                                        </a>
                                        <span class="font-display text-base leading-none font-bold text-accent-deep">
                                            {sibling.data.priceFrom
                                                ? `${strings.services.from} ${formatPrice(sibling.data.priceFrom.amount, locale)}`
                                                : strings.services.onRequest}
                                        </span>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    )
                }
            </aside>
        </div>
    </Section>

    <QuoteBand
        locale={locale}
        page={path}
        heading={data.quoteHeading}
        service={data.translationKey}
    />
</Layout>
