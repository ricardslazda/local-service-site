---
import { t } from '../i18n/strings.ts';
import { formatPrice } from '../lib/format.ts';
import type { Locale } from '../site.ts';

interface Props {
    locale: Locale;
    rows: { item: string; from: number; unit?: string }[];
    note: string;
}

const { locale, rows, note } = Astro.props;
const strings = t(locale);
---

<table class="w-full border-collapse text-base">
    <tbody>
        {
            rows.map((row) => (
                <tr class="border-t border-rule">
                    <td class="py-3.5 pr-4 text-ink-2">{row.item}</td>
                    <td class="py-3.5 text-right whitespace-nowrap">
                        <span class="text-[13px] tracking-[0.06em] text-muted uppercase">
                            {strings.services.from}
                        </span>
                        <span class="ml-1.5 font-display text-[24px] leading-none font-bold text-ink">
                            {formatPrice(row.from, locale)}
                        </span>
                        {row.unit && (
                            <span class="ml-1 text-[13px] text-muted">
                                {row.unit}
                            </span>
                        )}
                    </td>
                </tr>
            ))
        }
        <tr class="border-y border-rule">
            <td colspan="2" class="py-3.5 text-sm text-muted">{note}</td>
        </tr>
    </tbody>
</table>
