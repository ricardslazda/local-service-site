---
import { t } from '../i18n/strings.ts';
import type { Locale } from '../site.ts';
import { site } from '../site.ts';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
---

<div
    class="fixed inset-x-0 bottom-0 z-30 flex items-center justify-between gap-3 border-t border-rule bg-paper px-4 py-2.5 md:hidden"
>
    <p class="min-w-0 text-[13px] leading-tight text-ink-2">
        <strong class="block font-semibold text-ink"
            >{strings.callBar.lead}</strong
        >
        {strings.callBar.body}
    </p>
    <a
        href={`tel:${site.phone.e164}`}
        class="inline-flex min-h-12 shrink-0 items-center gap-2 rounded-sm bg-accent-deep px-3 text-accent-ink hover:bg-accent-hover"
    >
        <span class="text-xs font-semibold tracking-[0.08em] uppercase">
            {strings.cta.call}
        </span>
        <span class="font-display text-[22px] leading-none font-bold">
            {site.phone.display}
        </span>
    </a>
</div>
