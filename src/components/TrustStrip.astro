---
interface Props {
    items: string[];
    tone?: 'light' | 'dark';
    class?: string;
}

const { items, tone = 'light', class: className } = Astro.props;
---

<ul
    class:list={[
        'flex flex-wrap gap-x-8 gap-y-3 text-[15px]',
        tone === 'dark' ? 'text-band-lead' : 'text-ink-2',
        className,
    ]}
>
    {
        items.map((item) => (
            <li class="flex items-center gap-2.5">
                <span aria-hidden="true" class="size-2 shrink-0 bg-accent" />
                {item}
            </li>
        ))
    }
</ul>
