---
import { t } from '../i18n/strings.ts';
import { formatPrice } from '../lib/format.ts';
import type { Locale } from '../site.ts';

interface Props {
    locale: Locale;
    amount: number;
    unit?: string;
    size?: 'md' | 'lg';
    class?: string;
}

const { locale, amount, unit, size = 'md', class: className } = Astro.props;
---

<p class:list={['flex flex-wrap items-baseline gap-x-1.5', className]}>
    <span class="text-[13px] tracking-[0.06em] text-muted uppercase">
        {t(locale).services.from}
    </span>
    <span
        class:list={[
            'font-display leading-none font-bold',
            size === 'lg' ? 'text-[40px] text-accent' : 'text-[24px] text-ink',
        ]}
    >
        {formatPrice(amount, locale)}
    </span>
    {unit && <span class="text-[13px] text-muted">{unit}</span>}
</p>
