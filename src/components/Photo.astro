---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
    src: ImageMetadata;
    alt: string;
    widths?: number[];
    sizes?: string;
    class?: string;
}

const {
    src,
    alt,
    widths = [480, 768, 1200, 1600],
    sizes = '(min-width: 80rem) 60rem, 100vw',
    class: className,
} = Astro.props;
---

<Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    class:list={['block h-auto w-full object-cover', className]}
/>
